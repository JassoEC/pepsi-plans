NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-supabase-publishable-key
# Legacy local projects may expose an anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key
# Server-only secret used to derive stable Moment invitation tokens (32+ characters).
MOMENT_INVITE_SECRET=replace-with-a-random-secret-at-least-32-characters
